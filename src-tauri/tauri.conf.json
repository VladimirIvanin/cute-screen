{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cute Screen",
  "version": "0.1.27",
  "identifier": "io.github.vladimirivanin.cute-screen",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["default", "quick-capture", "settings", "emoji-attribution"],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/blobs/**", "$APPCACHE/resources/**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Cute Screen",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": true,
        "resizable": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Vladimir Ivanin",
    "targets": ["deb", "appimage"],
    "linux": {
      "deb": {
        "depends": ["libc6 (>= 2.35)", "libwebkit2gtk-4.1-0 (>= 2.40)", "xdg-utils"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/activation-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
