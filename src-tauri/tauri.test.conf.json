{
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "test-harness",
          "description": "Test-only permissions for the embedded WDIO driver.",
          "windows": ["main", "quick-capture"],
          "permissions": [
            "core:default",
            "core:window:default",
            "core:window:allow-close",
            "core:window:allow-hide",
            "wdio:default"
          ]
        }
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/blobs/**",
          "$APPCACHE/resources/**",
          "$APPCACHE/m01-fixtures/**"
        ]
      }
    }
  }
}
