{
  "identifier": "io.github.vladimirivanin.cute-screen.e2e",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "test-harness",
          "description": "Test-only permissions for the embedded WDIO driver.",
          "windows": ["main", "quick-capture", "settings"],
          "permissions": [
            "core:default",
            "core:window:default",
            "core:window:allow-close",
            "core:window:allow-hide",
            "core:window:allow-show",
            "core:window:allow-set-focus",
            "core:window:allow-set-always-on-top",
            "wdio:default"
          ]
        }
      ],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/blobs/**", "$APPCACHE/resources/**", "$APPCACHE/m01-fixtures/**"]
      }
    }
  }
}
