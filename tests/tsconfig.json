{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@cute-screen/editor-core": ["../packages/editor-core/src/index.ts"],
      "@cute-screen/editor-renderer": [
        "../packages/editor-renderer/src/index.ts"
      ],
      "@cute-screen/editor-vue": ["../packages/editor-vue/src/index.ts"],
      "canvaskit-wasm": [
        "./../packages/editor-renderer/src/canvaskit-wasm-shim.d.ts"
      ]
    },
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "../vitest.config.ts",
    "../packages/editor-core/src/**/*.test.ts",
    "../packages/editor-renderer/src/**/*.test.ts",
    "boundaries/**/*.ts",
    "fake-platform/**/*.ts",
    "fixtures/**/*.ts",
    "harness/**/*.ts",
    "unit/**/*.ts"
  ]
}
