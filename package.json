{
  "name": "cute-screen",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "22.23.1",
    "pnpm": "10.33.2"
  },
  "scripts": {
    "preinstall": "node scripts/verify-toolchain.mjs",
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "pnpm build:packages && vite build --config apps/desktop/vite.config.ts",
    "build:packages": "vue-tsc -b packages/editor-core packages/editor-renderer packages/editor-vue",
    "tauri": "tauri",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm docs:check && pnpm test:boundaries",
    "lint": "eslint .",
    "typecheck": "pnpm build:packages && vue-tsc --noEmit -p apps/desktop/tsconfig.json && vue-tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "docs:check": "node scripts/check-markdown-links.mjs",
    "doctor": "node scripts/check-tauri-prerequisites.mjs",
    "test": "vitest run --project core --project vue --project fixtures --project fake-platform",
    "test:coverage": "vitest run --coverage --project core --project vue --project fixtures --project fake-platform",
    "test:boundaries": "vitest run --project boundaries",
    "test:render": "vitest run --project render-harness",
    "test:perf": "vitest run --project perf-harness",
    "test:e2e:browser": "wdio run tests/e2e/wdio.browser.conf.ts",
    "test:e2e:tauri": "node scripts/run-tauri-e2e.mjs",
    "verify:release-boundary": "node scripts/verify-release-boundary.mjs",
    "licenses": "node scripts/check-js-licenses.mjs",
    "audit:licenses": "pnpm licenses",
    "audit:security": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@cute-screen/editor-vue": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/vue": "8.1.0",
    "@types/mocha": "10.0.10",
    "@types/node": "26.1.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/test-utils": "2.4.11",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/junit-reporter": "9.30.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "ajv": "8.20.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "fast-glob": "3.3.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "license-checker-rseidelsohn": "4.4.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9",
    "webdriverio": "9.30.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
