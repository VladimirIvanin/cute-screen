{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "canvaskit-wasm": ["./src/canvaskit-wasm-shim.d.ts"]
    },
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../editor-core" }]
}
