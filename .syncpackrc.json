{
  "$schema": "./node_modules/syncpack/schema.json",
  "source": ["package.json", "apps/*/package.json", "packages/*/package.json"],
  "versionGroups": [
    {
      "label": "Internal packages use the workspace protocol",
      "dependencies": ["@cute-screen/**"],
      "dependencyTypes": ["prod", "dev"],
      "pinVersion": "workspace:*"
    }
  ],
  "semverGroups": [
    {
      "label": "External dependencies are pinned exactly",
      "dependencyTypes": ["prod", "dev"],
      "specifierTypes": ["exact", "range", "range-complex", "range-major", "range-minor", "major", "minor"],
      "range": ""
    }
  ]
}
